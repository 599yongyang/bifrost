def password(path):
    require(Path(path).stat().st_mode & 0o077 == 0, 'postgres.env 权限必须为 600 或更严格')
    lines = [s for s in Path(path).read_text().splitlines() if s.strip() and not s.lstrip().startswith('#')]
    require(len(lines) == 1 and lines[0].startswith('BF_DB_PASSWORD='), '密码文件只能包含一行原始格式的 BF_DB_PASSWORD=...')
    result = lines[0].split('=', 1)[1]
    require(bool(result) and '\x00' not in result, '数据库密码为空或格式无效')
    return result


def read_secret(label):
    require(sys.stdin.isatty(), '输入数据库密码需要交互式终端')
    first = getpass.getpass(f'请输入 {label} PostgreSQL 密码：')
    second = getpass.getpass(f'请再次输入 {label} PostgreSQL 密码：')
    require(first == second and bool(first) and '\n' not in first and '\x00' not in first,
            '两次密码不一致，或密码包含不支持的字符')
    return first


def db_check(config, secret, role):
    check_config(config, role)
    env = {k: v for k, v in os.environ.items() if not k.startswith('PG')}
    env.update(PGPASSWORD=password(secret), PGOPTIONS='-c default_transaction_read_only=on -c statement_timeout=10000')
    for key in ('config_store', 'logs_store'):
        cfg = config[key]['config']
        sql = "SELECT current_database() || '|' || current_user || '|' || ssl::text FROM pg_stat_ssl WHERE pid=pg_backend_pid();"
        conn = f"host=10.1.12.7 port=5432 dbname={cfg['db_name']} user={cfg['user']} sslmode=require connect_timeout=5"
        args = ['psql', conn, '-X', '-w', '-At', '-v', 'ON_ERROR_STOP=1', '-c']
        result = run(args + [sql], env=env).strip()
        require(result == f"{cfg['db_name']}|{cfg['user']}|true", '数据库身份或 TLS 校验失败')
        if key == 'config_store':
            result = run(args + ["SELECT path FROM config_plugins WHERE name='moon' AND enabled=true;"], env=env).strip()
            require(result == ENTRY, '共享 Moon 插件入口异常或未启用；不要自动修改共享数据库')
            if role == 'test':
                result = run(args + ["SELECT COUNT(*) FROM config_plugins WHERE name='otel' AND enabled=true;"], env=env).strip()
                require(result == '0', '测试环境 OTel 仍处于启用状态，请先检查环境隔离')
        else:
            result = run(args + ["SELECT to_regclass('public.logs') IS NOT NULL;"], env=env).strip()
            require(result == 't', '日志库表结构尚未初始化；本工具不会初始化数据库')


def check_tree(path):
    require(path.is_dir() and not path.is_symlink(), f'目录不存在或不是普通目录：{path}')
    for item in path.rglob('*'):
        require(not item.is_symlink() and (item.is_dir() or item.is_file()), f'不支持符号链接或特殊文件：{item}')


def has_raw_postgres_env(text):
    """Validate the one supported env_file shape without depending on Compose's JSON normalization."""
    lines = text.splitlines()
    starts = [i for i, line in enumerate(lines) if line.strip() == 'env_file:']
    if len(starts) != 1:
        return False
    start = starts[0]
    base = len(lines[start]) - len(lines[start].lstrip())
    block = []
    for line in lines[start + 1:]:
        if line.strip() and len(line) - len(line.lstrip()) <= base:
            break
        if line.strip() and not line.lstrip().startswith('#'):
            block.append(line.strip())
    entries = [line for line in block if line.startswith('-')]
    paths = [line for line in block if re.fullmatch(r"-\s+path:\s*(['\"]?)\./postgres\.env\1", line)]
    formats = [line for line in block if re.fullmatch(r"format:\s*(['\"]?)raw\1", line)]
    return len(entries) == len(paths) == len(formats) == 1


def normalize_legacy_service(service, compose_source):
    require(has_raw_postgres_env(compose_source), '旧 Compose 必须且只能声明一个 format: raw 的 ./postgres.env')
    require(not re.search(r'^\s*BF_DB_PASSWORD\s*:', compose_source, re.MULTILINE),
            '不要在 Compose environment 中直接声明 BF_DB_PASSWORD')
    service = copy.deepcopy(service)
    # Compose 2.40 may resolve env_file into environment and report env_file=null.
    # The source declaration above is authoritative; never persist the resolved secret.
    service.pop('env_file', None)
    environment = service.get('environment') or {}
    require(isinstance(environment, dict), '旧 Compose 的 environment 必须使用映射格式')
    environment.pop('BF_DB_PASSWORD', None)
    service['environment'] = environment
    return service


def read_versions(root):
    values = {}
    for line in (root / 'versions.env').read_text().splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        key, sep, value = line.partition('=')
        require(sep and key in {f'{r.upper()}_VERSION' for r in ROLES} and key not in values,
                'versions.env 只允许唯一的 ROLE_VERSION=版本 行，不能包含 Shell 语法')
        values[key] = version(value)
    return values


def release(root, ver):
    path = root / 'releases' / version(ver)
    require(path.is_dir() and (path / 'release.json').is_file(),
            f'目标版本 {ver} 尚未导入；请先执行 import')
    manifest = read_json(path / 'release.json')
    require(manifest.get('version') == ver, '发布清单中的版本不一致')
    require(sha(path / 'moon.so') == manifest['plugin_sha256'], '发布插件 SHA-256 校验失败')
    info = image_info(f'bifrost-moon:{ver}')
    require(fingerprint(info) == manifest['image_fingerprint'], '镜像与登记的发布版本不一致；禁止复用版本标签')
    return manifest, info['Id']


def pack(args):
    ver = version(args.version)
    info = image_info(f'bifrost-moon:{ver}')
    plugin = Path(args.plugin).resolve()
    require(plugin.is_file(), '插件文件不存在')
    output = Path(args.output).resolve()
    require(not output.exists(), '输出目录已存在；发布包不可覆盖')
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.bf-package-', dir=output.parent) as temp:
        stage = Path(temp)
        shutil.copyfile(plugin, stage / 'moon.so')
        run(['docker', 'image', 'save', '-o', str(stage / 'image.tar'), f'bifrost-moon:{ver}'], timeout=600)
        require(fingerprint(image_info(f'bifrost-moon:{ver}')) == fingerprint(info), '打包过程中镜像发生变化')
        write_json(stage / 'release.json', {'version': ver, 'image_fingerprint': fingerprint(info),
                   'plugin_sha256': sha(stage / 'moon.so'), 'archive_sha256': sha(stage / 'image.tar')})
        shutil.copytree(stage, output)
    print(f'PACKAGE_READY: {output}；镜像/插件配套、ABI 和推理功能仍需在测试环境验证')


def import_bundle(root, args):
    source = Path(args.bundle).resolve()
    manifest = read_json(source / 'release.json')
    ver = version(manifest['version'])
    target = root / 'releases' / ver
    require(not target.exists(), '该发布版本已登记，拒绝覆盖')
    require(sha(source / 'moon.so') == manifest['plugin_sha256'], '发布包中的插件 SHA-256 校验失败')
    require(sha(source / 'image.tar') == manifest['archive_sha256'], '发布包中的镜像归档 SHA-256 校验失败')
    tag = f'bifrost-moon:{ver}'
    existing = run(['docker', 'image', 'ls', '-q', tag]).strip()
    if existing:
        require(fingerprint(image_info(tag)) == manifest['image_fingerprint'], '同名镜像标签已存在，但内容不同')
    else:
        print('正在加载已校验的镜像归档（不会重启 Bifrost）……', flush=True)
        run(['docker', 'image', 'load', '-i', str(source / 'image.tar')], timeout=600)
    require(fingerprint(image_info(tag)) == manifest['image_fingerprint'], '加载后的镜像与发布清单不一致')
    with tempfile.TemporaryDirectory(prefix='.import-', dir=root / 'releases') as temp:
        stage = Path(temp)
        for name in ('moon.so', 'image.tar', 'release.json'):
            shutil.copyfile(source / name, stage / name)
        require(sha(stage / 'moon.so') == manifest['plugin_sha256'] and sha(stage / 'image.tar') == manifest['archive_sha256'],
                '复制过程中发布包内容发生变化')
        os.chmod(stage / 'moon.so', 0o644)
        os.rename(stage, target)
    placeholder = root / 'plugins' / Path(ENTRY).name
    if not placeholder.exists():
        shutil.copyfile(target / 'moon.so', placeholder)
        os.chmod(placeholder, 0o644)
    print(f'IMPORTED: {ver}；当前运行版本未改变')


def init(root):
    require(not (root / 'config/node.json').exists(), '节点已经初始化，init 不会覆盖现有配置')
    ip = local_ip()
    profiles = {}
    # Complete read-only validation before creating deployment configuration.
    for role, directory in LEGACY[ip].items():
        source = Path(directory)
        document = json.loads(compose(source / 'compose.yaml', 'config', '--no-env-resolution', '--format', 'json'))
        require(set(document['services']) == {'bifrost'}, '旧 Compose 必须且只能包含 bifrost 服务')
        service = normalize_legacy_service(document['services']['bifrost'], (source / 'compose.yaml').read_text())
        require(service.get('container_name') == 'bifrost', '旧容器名称与预期不一致')
        require(service.get('network_mode', 'bridge') == 'bridge', '自定义网络模式需要人工审查后才能接管')
        # `compose config` materializes the implicit default network even if YAML omitted it.
        require(not (set(service.get('networks', {})) - {'default'}), '自定义网络需要人工审查后才能接管')
        networks = document.get('networks', {})
        if networks.get('default', {}).get('ipam') == {}:
            networks['default'].pop('ipam')
        require(not networks or networks == {'default': {'name': document['name'] + '_default'}},
                '非默认网络配置需要人工审查后才能接管')
        service.pop('networks', None)
        ver = version(service['image'].removeprefix('bifrost-moon:'))
        require(service['image'] == f'bifrost-moon:{ver}', '镜像仓库名称与预期不一致')
        mounts = {m['target']: m for m in service['volumes']}
        required = {'/app/data', '/app/data/config.json', '/app/data/plugins'}
        require(required <= mounts.keys() and not (mounts.keys() - required - {ENTRY}), '挂载项缺失或包含未知挂载，请人工审查后再接管')
        require(all(m['type'] == 'bind' for m in mounts.values()), '接管仅支持 bind 挂载')
        require(Path(mounts['/app/data']['source']) == source / 'data', '旧数据目录与预期不一致')
        require(Path(mounts['/app/data/config.json']['source']) == source / 'config.json', '旧配置文件路径与预期不一致')
        require(Path(mounts['/app/data/plugins']['source']) == PLUGIN_DIR, '旧插件目录与预期不一致')
        check_config(read_json(source / 'config.json'), role)
        password(source / 'postgres.env')
        check_ports(service, role)
        check_tree(source / 'data')
        plugin = Path(mounts.get(ENTRY, {}).get('source', str(PLUGIN_DIR / f'bifrost-moon-response-sanitizer-linux-amd64-glibc-{ver}.so')))
        require(plugin.is_file(), '缺少与镜像配套的插件文件')
        info = image_info(service['image'])
        profiles[role] = {'legacy': str(source), 'legacy_project': document['name'], 'service': service, 'version': ver,
                          'plugin': str(plugin), 'manifest': {'version': ver, 'plugin_sha256': sha(plugin), 'image_fingerprint': fingerprint(info)},
                          'source_hashes': {name: sha(source / name) for name in ('compose.yaml', 'config.json', 'postgres.env')}}
    check_tree(PLUGIN_DIR)
    for name in ('config', 'secrets', 'releases', 'data', 'backups', 'inbox'):
        (root / name).mkdir(mode=0o700, parents=True, exist_ok=True)
    for role, profile in profiles.items():
        source = Path(profile['legacy'])
        cfg = root / 'config' / f'{role}.json'
        secret = root / 'secrets' / f'{role}.env'
        require(not cfg.exists() and not secret.exists(), '发现未完成的初始化文件，请检查后处理，不要覆盖')
        shutil.copyfile(source / 'config.json', cfg)
        shutil.copyfile(source / 'postgres.env', secret)
        os.chmod(cfg, 0o600)
        os.chmod(secret, 0o600)
        target = root / 'releases' / profile['version']
        if not target.exists():
            target.mkdir(mode=0o700)
            shutil.copyfile(profile['plugin'], target / 'moon.so')
            os.chmod(target / 'moon.so', 0o644)
            write_json(target / 'release.json', profile['manifest'])
        else:
            require(read_json(target / 'release.json') == profile['manifest'], '同一版本存在内容冲突的节点产物')
        write_json(root / 'config' / f'{role}.compose.json', profile['service'])
    require(not (root / 'plugins').exists(), '插件暂存目录已经存在，请检查未完成的初始化')
    shutil.copytree(PLUGIN_DIR, root / 'plugins', copy_function=shutil.copy2)
    write_json(root / 'config/node.json', {'ip': ip, 'profiles': profiles})
    atomic_write(root / 'versions.env', ''.join(f'{r.upper()}_VERSION={p["version"]}\n' for r, p in profiles.items()))
    print(f'INITIALIZED: {ip} -> {root}；旧容器、旧目录和数据库均未修改')
    print('下一步：对当前相同版本和角色执行 plan，然后执行 adopt。只有停止旧写入进程后才会复制数据。')


def bootstrap(root, args):
    """Create a clean standardized node. This never adopts an old container or directory."""
    require(not (root / 'config/node.json').exists(), '节点已经初始化，bootstrap 不会覆盖现有节点')
    require(container() is None, '已经存在 bifrost 容器；旧部署请使用 init/adopt，其他情况请人工审查')
    ip = args.ip
    require(ip in global_ips(), '指定 IP 不属于当前主机')
    ver = version(args.version)
    roles = ('production',) if args.node_type == 'production' else ('test', 'standby')
    paths = {name: root / name for name in ('config', 'secrets', 'releases', 'data', 'backups', 'inbox', 'plugins')}
    for path in paths.values():
        require(not path.exists(), f'发现未完成的 bootstrap 路径：{path}；请检查后处理，不要覆盖')
    secrets = {}
    for role in roles:
        label = 'bf_test' if role == 'test' else 'bf_prod'
        secrets[role] = read_secret(label)

    # Validate credentials and database identity before writing node configuration.
    with tempfile.TemporaryDirectory(prefix='.bootstrap-check-', dir=root) as temp:
        temp = Path(temp)
        for role in roles:
            secret = temp / f'{role}.env'
            atomic_write(secret, f'BF_DB_PASSWORD={secrets[role]}\n')
            db_check(standard_config(role), secret, role)

    for name, path in paths.items():
        path.mkdir(mode=0o750 if name == 'plugins' else 0o700)
    profiles = {}
    for role in roles:
        write_json(root / 'config' / f'{role}.json', standard_config(role))
        write_json(root / 'config' / f'{role}.compose.json', standard_service(role))
        atomic_write(root / 'secrets' / f'{role}.env', f'BF_DB_PASSWORD={secrets[role]}\n')
        profiles[role] = {'provisioned_by': 'bootstrap'}
    write_json(root / 'config/node.json', {'ip': ip, 'profiles': profiles, 'provisioned_by': 'bootstrap'})
    atomic_write(root / 'versions.env', ''.join(f'{role.upper()}_VERSION={ver}\n' for role in roles))
    print(f'BOOTSTRAPPED: {ip}，角色={",".join(roles)}，目标版本={ver}；未启动任何容器')
    print('下一步：导入配套发布包，然后执行 plan 和 launch 启动首个角色。')


def check_ports(service, role):
    ports = service.get('ports', [])
    expected = '18080' if role == 'test' else '8080'
    require(bool(ports) and all(str(p['published']) == expected and p['target'] == 8080 and p.get('protocol', 'tcp') == 'tcp' for p in ports),
            f'{role} 只能发布 {expected}->8080/tcp')


def node(root):
    value = read_json(root / 'config/node.json')
    if value['ip'] in LEGACY:
        require(value['ip'] == local_ip(), '节点配置属于另一台主机')
    else:
        require(value['ip'] in global_ips(), '节点配置中的 IP 不属于当前主机')
    return value


def build_compose(root, role, ver, image_id, revision, service):
    service = copy.deepcopy(service)
    service.update(image=image_id, pull_policy='never', container_name='bifrost')
    service.setdefault('labels', {}).update({'bifrost.managed_by': 'bifrost-deploy', 'bifrost.deployment_role': role,
                                            'bifrost.release': ver, 'bifrost.revision': str(revision)})
    service['env_file'] = [{'path': str(revision / 'postgres.env'), 'format': 'raw'}]
    service['volumes'] = []
    for source, target, readonly in [(root / 'data' / role, '/app/data', False),
                                     (revision / 'config.json', '/app/data/config.json', True),
                                     (root / 'plugins', '/app/data/plugins', True),
                                     (root / 'releases' / ver / 'moon.so', ENTRY, True)]:
        service['volumes'].append({'type': 'bind', 'source': str(source), 'target': target,
                                   'read_only': readonly, 'bind': {'create_host_path': False}})
    check_ports(service, role)
    return {'name': PROJECT, 'services': {'bifrost': service}}


def prepare(root, role):
    cfg = node(root)
    require(role in cfg['profiles'], '当前节点不允许使用这个角色')
    ver = read_versions(root).get(f'{role.upper()}_VERSION')
    require(ver is not None, 'versions.env 缺少当前角色的版本变量')
    manifest, image_id = release(root, ver)
    require((root / 'plugins' / Path(ENTRY).name).is_file(), '保留插件目录中缺少固定入口文件')
    config = read_json(root / 'config' / f'{role}.json')
    service = read_json(root / 'config' / f'{role}.compose.json')
    check_ports(service, role)
    require('BF_DB_PASSWORD' not in service.get('environment', {}), '数据库密码只能存放在密码文件中')
    db_check(config, root / 'secrets' / f'{role}.env', role)
    print(f"目标节点：{cfg['ip']}  角色={role}  版本={ver}  端口={'18080' if role == 'test' else '8080'}")
    print(f"数据库：{config['config_store']['config']['db_name']} + {config['logs_store']['config']['db_name']}")
    print(f"插件 SHA-256：{manifest['plugin_sha256']}")
    return cfg, ver, image_id, service


def no_data_writer(path):
    ids = run(['docker', 'ps', '-q']).split()
    if not ids:
        return
    for item in json.loads(run(['docker', 'inspect', *ids])):
        for mount in item.get('Mounts', []):
            source = Path(mount['Source'])
            if mount.get('RW', True):
                require(not (source == path or source in path.parents or path in source.parents),
                        '仍有运行中的容器以可写方式挂载旧数据目录，请先停止对应写入进程')


def confirm(action, role, ver):
    print('请确认：调用来源已停止或摘流，在途图片/视频任务及日志刷新已妥善处理。')
    if role in ('production', 'standby'):
        print('生产门槛：测试已通过，已审查新旧版本共用表结构及回退兼容性，数据库备份可用。')
    else:
        print('测试门槛：已确认真实供应商费用、测试数据库以及测试专用外部目标。')
    print('本工具不会切换 NewAPI 渠道、备份/恢复 PostgreSQL，也不能替代真实业务验收。')
    token = f'{action} {role} {ver}'
    require(sys.stdin.isatty(), '必须在交互式终端确认，不允许绕过确认无人值守执行')
    require(input(f'请输入 {token!r} 继续：') == token, '操作已取消，部署没有变化')


def ensure_managed(current):
    managers = ('bfctl', 'bifrost-deploy')
    require(current is not None and current['Config'].get('Labels', {}).get('bifrost.managed_by') in managers,
            '当前容器不由 bifrost-deploy 管理；只有旧部署才能使用 adopt')
    require(current['Config']['Labels'].get('com.docker.compose.project') == PROJECT, 'Compose 项目名称与预期不一致')


def legacy_role(current, cfg):
    require(current is not None, '没有找到旧 bifrost 容器')
    labels = current['Config'].get('Labels', {})
    directory = labels.get('com.docker.compose.project.working_dir')
    matches = [r for r, p in cfg['profiles'].items() if p.get('legacy') == directory and p.get('legacy_project') == labels.get('com.docker.compose.project')]
    require(len(matches) == 1, '旧容器所属项目或路径与登记配置不一致')
    return matches[0]


def state(root):
    return read_json(root / 'state.json') if (root / 'state.json').exists() else None


def new_revision(root, role, ver, image_id, service):
    revision = Path(tempfile.mkdtemp(prefix=dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ-'), dir=root / 'backups'))
    for source, name in [(root / 'config' / f'{role}.json', 'config.json'),
                         (root / 'secrets' / f'{role}.env', 'postgres.env')]:
        shutil.copyfile(source, revision / name)
        os.chmod(revision / name, 0o640 if name == 'config.json' else 0o600)
    # Container user is 1000:0; root group may read only the bind-mounted config, never the password file.
    os.chown(revision / 'config.json', 0, 0)
    document = build_compose(root, role, ver, image_id, revision, service)
    write_json(revision / 'compose.yaml', document)  # JSON is valid YAML, no PyYAML dependency.
    compose(revision / 'compose.yaml', 'config', '--quiet')
    write_json(revision / 'metadata.json', {'role': role, 'version': ver,
               'config_sha256': sha(revision / 'config.json'), 'secret_sha256': sha(revision / 'postgres.env')})
    return {'kind': 'managed', 'role': role, 'version': ver, 'revision': str(revision)}


def verify(root, expected):
    require(expected and expected['kind'] == 'managed', '没有可以验证的受管版本')
    revision = Path(expected['revision'])
    metadata = read_json(revision / 'metadata.json')
    require(sha(revision / 'config.json') == metadata['config_sha256'] and sha(revision / 'postgres.env') == metadata['secret_sha256'],
            '受保护的版本配置或密码文件已被修改')
    manifest, image_id = release(root, expected['version'])
    current = container()
    ensure_managed(current)
    labels = current['Config']['Labels']
    require(labels.get('bifrost.revision') == str(revision) and labels.get('bifrost.deployment_role') == expected['role'], '运行版本或角色与状态文件不一致')
    require(current['Image'] == image_id and current['State'].get('Health', {}).get('Status') == 'healthy', '镜像或健康状态与预期不一致')
    expected_mounts = {m['target']: m['source'] for m in read_json(revision / 'compose.yaml')['services']['bifrost']['volumes']}
    actual_mounts = {m['Destination']: m['Source'] for m in current['Mounts']}
    require(all(actual_mounts.get(k) == v for k, v in expected_mounts.items()), '容器实际挂载与部署配置不一致')
    for path, checksum in [(ENTRY, manifest['plugin_sha256']), ('/app/data/config.json', metadata['config_sha256'])]:
        require(run(['docker', 'exec', 'bifrost', 'sha256sum', path]).split()[0] == checksum, '容器内文件 SHA-256 校验失败')
    health = json.loads(run(['docker', 'exec', 'bifrost', 'wget', '-qO-', 'http://127.0.0.1:8080/health']))
    require(health.get('status') == 'ok' and health.get('components', {}).get('db_pings') == 'ok', '容器内数据库健康检查失败')
    db_check(read_json(revision / 'config.json'), revision / 'postgres.env', expected['role'])
    receipt = revision / 'startup-evidence.json'
    identity = {'container_id': current['Id'], 'started_at': current['State']['StartedAt'],
                'plugin_sha256': manifest['plugin_sha256']}
    if not receipt.exists() or read_json(receipt) != identity:
        logs = run(['docker', 'logs', '--since', current['State']['StartedAt'], '--tail', '5000', 'bifrost'], merge_stderr=True)
        require(re.search(r'plugin status:\s*moon\s*-\s*active', logs),
                '未找到 Moon 启动成功证据（不等于插件未运行）；接入流量前请检查私有启动日志')
        # No secret log contents saved. A restart/new container invalidates this receipt.
        write_json(receipt, identity)
    print('VERIFY_OK: 镜像、挂载文件、数据库账号/TLS、数据库健康状态和 Moon 启动证据均匹配。')
    print('启用渠道前仍需验证：真实生图、结果可见性、身份隐藏、fallback 和 Langfuse。')


def start(root, expected):
    revision = Path(expected['revision'])
    atomic_write(root / 'compose.yaml', (revision / 'compose.yaml').read_text())
    compose(root / 'compose.yaml', 'up', '-d', '--force-recreate', '--pull', 'never', '--wait', '--wait-timeout', '120', timeout=480)
    verify(root, expected)


def launch(root, role):
    require(not (root / 'pending.json').exists(), '存在未完成操作；请先检查 status 并执行 rollback')
    require(state(root) is None and container() is None, '首次启动要求不存在旧状态和 bifrost 容器')
    _, ver, image_id, service = prepare(root, role)
    confirm('LAUNCH', role, ver)
    after = new_revision(root, role, ver, image_id, service)
    db_check(read_json(Path(after['revision']) / 'config.json'), Path(after['revision']) / 'postgres.env', role)
    before = {'kind': 'absent', 'role': role, 'version': ver}
    journal = {'before': before, 'after': after}
    data = root / 'data' / role
    require(not data.exists(), '首次启动的数据目录已经存在，请检查未完成的启动操作')
    write_json(root / 'pending.json', journal)
    write_json(Path(after['revision']) / 'transition.json', journal)
    data.mkdir(mode=0o2770)
    os.chown(data, 1000, 0)
    start(root, after)
    write_json(root / 'state.json', after)
    write_json(root / 'last-transition.json', journal)
    (root / 'pending.json').unlink()
    print('LAUNCHED: 基础验证通过。真实业务冒烟测试通过前请保持渠道禁用。')


def deploy(root, role, adopt=False):
    require(not (root / 'pending.json').exists(), '存在未完成操作；请先检查 status 并执行 rollback')
    cfg, ver, image_id, service = prepare(root, role)
    current = container()
    previous = state(root)
    if adopt:
        require(previous is None, '节点已经接管，请使用 deploy')
        require(legacy_role(current, cfg) == role, 'adopt 必须保持旧容器当前角色；完成接管后才能切换模式')
        profile = cfg['profiles'][role]
        require(ver == profile['version'] and current['Config']['Image'] == f'bifrost-moon:{ver}', '接管过程中不能修改发布版本')
        for name, digest in profile['source_hashes'].items():
            require(sha(Path(profile['legacy']) / name) == digest, '旧部署文件在 init 后发生变化，请重新审查后再接管')
        require(current['Image'] == image_id, '旧容器运行镜像与登记发布版本不一致')
        previous = {'kind': 'legacy', 'role': role, 'version': ver, 'container_id': current['Id'],
                    'restart': current['HostConfig']['RestartPolicy']['Name'],
                    'running': current['State']['Running'], 'legacy': profile['legacy']}
    else:
        ensure_managed(current)
        require(previous and current['Config']['Labels'].get('bifrost.revision') == previous['revision'], '状态文件与当前容器版本不一致')
    legacy = cfg['profiles'][role].get('legacy')
    require(not adopt or legacy, 'adopt 只适用于已登记的旧部署')
    source_data = Path(legacy) / 'data' if legacy else None
    if source_data and (adopt or not (root / 'data' / role).exists()):
        check_tree(source_data)
        size = sum(p.stat().st_size for p in source_data.rglob('*') if p.is_file())
        require(shutil.disk_usage(root).free > size + 128 * 1024 * 1024, '磁盘剩余空间不足，无法安全复制旧运行数据')
    confirm('ADOPT' if adopt else 'DEPLOY', role, ver)
    after = new_revision(root, role, ver, image_id, service)
    # Recheck the exact copied files, not a mutable profile read earlier in prepare().
    db_check(read_json(Path(after['revision']) / 'config.json'), Path(after['revision']) / 'postgres.env', role)
    if adopt:
        # Keep this historical prefix: already-adopted nodes use it to identify the preserved legacy container.
        previous['backup_name'] = 'bifrost-before-bfctl-' + Path(after['revision']).name.lower()
    journal = {'before': previous, 'after': after}
    # Write recovery information BEFORE the first action that stops a service.
    write_json(root / 'pending.json', journal)
    write_json(Path(after['revision']) / 'transition.json', journal)
    print('正在停止当前节点；NewAPI 渠道没有被本工具修改……', flush=True)
    run(['docker', 'stop', '--time', '300', current['Id']], timeout=360)
    stopped = json.loads(run(['docker', 'inspect', current['Id']]))[0]
    require(not stopped['State']['Running'] and stopped['State'].get('ExitCode') == 0 and not stopped['State'].get('OOMKilled'),
            '容器未正常退出或被强制停止；请保留现场并检查后再回退')
    if adopt:
        run(['docker', 'update', '--restart=no', current['Id']])
        run(['docker', 'rename', current['Id'], previous['backup_name']])
    # Never copy data while its writer is running; inactive node17 mode has a separate source.
    destination = root / 'data' / role
    if source_data and (adopt or not destination.exists()):
        no_data_writer(source_data)
    if adopt and destination.exists():
        # Re-adoption after restoring legacy must not reuse a stale earlier runtime copy.
        os.rename(destination, Path(after['revision']) / 'data-before-readoption')
    if not destination.exists():
        if source_data:
            with tempfile.TemporaryDirectory(prefix='.data-', dir=root / 'data') as temp:
                run(['cp', '-a', str(source_data) + '/.', temp], timeout=600)
                os.chown(temp, 1000, 0)
                os.chmod(temp, 0o2770)
                os.rename(temp, destination)
        else:
            destination.mkdir(mode=0o2770)
            os.chown(destination, 1000, 0)
    start(root, after)
    write_json(root / 'state.json', after)
    write_json(root / 'last-transition.json', journal)
    (root / 'pending.json').unlink()
    print('DEPLOYED: 基础验证通过。真实业务冒烟测试通过前请保持渠道禁用。')


def rollback(root):
    node(root)
    path = root / ('pending.json' if (root / 'pending.json').exists() else 'last-transition.json')
    require(path.exists(), '没有可用的上一条部署转换，无法自动回退')
    journal = read_json(path)
    before = journal['before']
    current = container()
    if current and not (before['kind'] == 'legacy' and current['Id'] == before['container_id']):
        ensure_managed(current)
        allowed = {journal['after']['revision']}
        if before['kind'] == 'managed':
            allowed.add(before['revision'])
        require(current['Config']['Labels'].get('bifrost.revision') in allowed,
                '当前容器与待回退的部署转换无关，请检查是否存在人工修改')
    confirm('ROLLBACK', before['role'], before['version'])
    # Persist even rollback attempts so a failed rollback remains recoverable.
    write_json(root / 'pending.json', journal)
    current = container()
    if before['kind'] == 'absent':
        if current:
            ensure_managed(current)
            if current['State']['Running']:
                run(['docker', 'stop', '--time', '300', current['Id']], timeout=360)
            run(['docker', 'update', '--restart=no', current['Id']])
            run(['docker', 'rename', current['Id'], 'bifrost-failed-' + dt.datetime.now().strftime('%Y%m%d%H%M%S')])
        if (root / 'state.json').exists():
            (root / 'state.json').unlink()
        if (root / 'compose.yaml').exists():
            os.replace(root / 'compose.yaml', Path(journal['after']['revision']) / 'active-before-first-launch-rollback.yaml')
        data = root / 'data' / before['role']
        if data.exists():
            os.replace(data, Path(journal['after']['revision']) / 'data-before-first-launch-rollback')
        print('INITIAL_LAUNCH_ROLLED_BACK: 当前没有活动的 Bifrost 容器；已保留生成的数据和诊断资料。')
    elif before['kind'] == 'legacy':
        old = json.loads(run(['docker', 'inspect', before['container_id']]))[0]
        if current and current['Id'] != old['Id']:
            ensure_managed(current)
            run(['docker', 'stop', '--time', '300', current['Id']], timeout=360)
            run(['docker', 'update', '--restart=no', current['Id']])
            run(['docker', 'rename', current['Id'], 'bifrost-failed-' + dt.datetime.now().strftime('%Y%m%d%H%M%S')])
        if old['Name'] != '/bifrost':
            run(['docker', 'rename', old['Id'], 'bifrost'])
        run(['docker', 'update', f"--restart={before['restart']}", old['Id']])
        if before['running']:
            run(['docker', 'start', old['Id']])
        if (root / 'state.json').exists():
            (root / 'state.json').unlink()
        if (root / 'compose.yaml').exists():
            os.replace(root / 'compose.yaml', Path(journal['after']['revision']) / 'active-before-legacy-rollback.yaml')
        print(f"LEGACY_RESTORED: 请使用 {before['legacy']}/compose.yaml，并人工验证健康状态和业务功能。")
    else:
        release(root, before['version'])
        db_check(read_json(Path(before['revision']) / 'config.json'), Path(before['revision']) / 'postgres.env', before['role'])
        if current:
            ensure_managed(current)
            run(['docker', 'stop', '--time', '300', current['Id']], timeout=360)
        start(root, before)
        write_json(root / 'state.json', before)
        print('ROLLED_BACK: versions.env 未修改；下次部署前请核对目标版本与运行版本。')
    (root / 'pending.json').unlink()
    if (root / 'last-transition.json').exists():
        (root / 'last-transition.json').unlink()
    print('本次没有恢复数据库。备份文件和容器均已保留，没有删除。')


def status(root):
    cfg = node(root)
    print(f"节点：{cfg['ip']}  根目录：{root}")
    print('目标版本：', json.dumps(read_versions(root)))
    current = container()
    if current:
        labels = current['Config'].get('Labels', {})
        print('运行状态：', json.dumps({'state': current['State']['Status'], 'health': current['State'].get('Health', {}).get('Status'),
              'role': labels.get('bifrost.deployment_role', 'legacy/unknown'), 'version': labels.get('bifrost.release', current['Config']['Image']),
              'managed': labels.get('bifrost.managed_by') in ('bfctl', 'bifrost-deploy'), 'ports': current['HostConfig']['PortBindings']}, ensure_ascii=False))
    else:
        print('运行状态：没有 bifrost 容器')
    print('存在待处理操作：', '是' if (root / 'pending.json').exists() else '否')


def main():
    parser = ChineseArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    package = commands.add_parser('pack', help='构建机：打包本地镜像和配套插件')
    package.add_argument('version')
    package.add_argument('--plugin', required=True)
    package.add_argument('--output', required=True)
    bootstrap_command = commands.add_parser('bootstrap', help='初始化全新标准节点，不启动容器')
    bootstrap_command.add_argument('node_type', choices=('production', 'test-standby'))
    bootstrap_command.add_argument('--ip', required=True)
    bootstrap_command.add_argument('--version', required=True)
    commands.add_parser('init', help='仅兼容旧环境：登记待接管的旧部署')
    commands.add_parser('status', help='查看角色、版本、端口和运行状态')
    commands.add_parser('verify', help='验证当前受管版本，不发起付费推理')
    commands.add_parser('rollback', help='交互式恢复上一套容器部署，不恢复数据库')
    bundle = commands.add_parser('import', help='登记不可变离线发布包，不重启服务')
    bundle.add_argument('bundle')
    for name in ('plan', 'launch', 'adopt', 'deploy'):
        command = commands.add_parser(name)
        command.add_argument('role', choices=ROLES)
    args = parser.parse_args()
    os.umask(0o077)
    if args.command == 'pack':
        pack(args)
        return
    require(sys.platform == 'linux' and os.geteuid() == 0, '请在已登记的 Ubuntu 服务器上使用 sudo 运行')
    require(Path(__file__).resolve() == ROOT / 'bifrost-deploy',
            '请先将脚本安装为 /opt/bifrost/bifrost-deploy')
    require(not ROOT.is_symlink() and ROOT.stat().st_uid == 0 and ROOT.stat().st_mode & 0o022 == 0,
            '/opt/bifrost 必须属于 root，且其他用户不可写入')
    # Prevent two local updates or imports racing. No distributed DB locks/writes.
    # Keep the legacy lock filename so an older installed bfctl and this renamed tool cannot run concurrently.
    with (ROOT / '.bfctl.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Refused('另一个 bifrost-deploy 操作正在执行')
        if args.command == 'bootstrap':
            bootstrap(ROOT, args)
        elif args.command == 'init':
            init(ROOT)
        elif args.command == 'status':
            status(ROOT)
        elif args.command == 'verify':
            verify(ROOT, state(ROOT))
        elif args.command == 'rollback':
            rollback(ROOT)
        elif args.command == 'import':
            node(ROOT)
            import_bundle(ROOT, args)
        elif args.command == 'plan':
            prepare(ROOT, args.role)
            print('PLAN_OK: 只读预检通过，容器和数据库均未修改。')
        elif args.command == 'launch':
            launch(ROOT, args.role)
        else:
            deploy(ROOT, args.role, adopt=args.command == 'adopt')


if __name__ == '__main__':
    try:
        main()
    except (Refused, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        if isinstance(error, Refused):
            print(f'STOP: {error}', file=sys.stderr)
        else:
            print(f'STOP: {type(error).__name__}；请检查本地文件和依赖（为保护敏感信息已隐藏详情）', file=sys.stderr)
        print('如果存在 pending.json，请勿启用渠道；先检查 status 并按回退流程处理。', file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print('\n操作已中断。如果存在 pending.json，请先检查 status 并执行 rollback，再进行下一次部署。', file=sys.stderr)
        sys.exit(130)
