import copy
import datetime as dt
import fcntl
import getpass
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


ROOT = Path('/opt/bifrost')
PLUGIN_DIR = Path('/opt/bifrost-data/plugins')
ENTRY = '/app/data/plugins/bifrost-moon-response-sanitizer-linux-amd64-glibc-2.0.0-moon.18.so'
LEGACY = {
    '10.1.4.5': {'production': '/opt/bifrost-pg'},
    '10.1.12.10': {'production': '/bifrost'},
    '10.1.12.17': {'test': '/opt/bifrost-envs/test', 'standby': '/opt/bifrost-envs/standby'},
}
ROLES = ('test', 'standby', 'production')
PROJECT = 'bifrost-unified'


class Refused(Exception):
    pass


class ChineseArgumentParser(argparse.ArgumentParser):
    def __init__(self, *args, **kwargs):
        kwargs['add_help'] = False
        super().__init__(*args, **kwargs)
        self._positionals.title = '命令与参数'
        self._optionals.title = '选项'
        self.add_argument('-h', '--help', action='help', help='显示帮助并退出')

    def format_usage(self):
        return super().format_usage().replace('usage:', '用法：', 1)

    def format_help(self):
        return super().format_help().replace('usage:', '用法：', 1)

    def error(self, message):
        if message.startswith('the following arguments are required:'):
            detail = message.split(':', 1)[1].strip()
            message = f'缺少必填参数：{detail}'
        elif 'invalid choice:' in message:
            message = '参数值不在允许范围，请查看 --help'
        elif message.startswith('unrecognized arguments:'):
            detail = message.split(':', 1)[1].strip()
            message = f'无法识别的参数：{detail}'
        else:
            message = '参数不正确，请查看 --help'
        self.print_usage(sys.stderr)
        self.exit(2, f'错误：{message}\n')


def require(condition, message):
    if not condition:
        raise Refused(message)


def run(args, *, env=None, timeout=60, merge_stderr=False):
    # Never echo command output on failure: Compose, psql and logs may contain secrets.
    result = subprocess.run(args, text=True, capture_output=True, env=env, timeout=timeout)
    require(result.returncode == 0, f'{args[0]} {args[1]} 执行失败（退出码 {result.returncode}）；为保护敏感信息已隐藏输出')
    return result.stdout + (result.stderr if merge_stderr else '')


def sha(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def read_json(path):
    return json.loads(Path(path).read_text())


def write_json(path, value):
    atomic_write(path, json.dumps(value, ensure_ascii=False, indent=2) + '\n')


def atomic_write(path, value):
    path = Path(path)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as stream:
        tmp = Path(stream.name)
        os.chmod(tmp, 0o600)
        stream.write(value)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(tmp, path)


def version(value):
    require(re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+-moon\.[0-9]+', value), 'Moon 发布版本格式不正确')
    return value


def image_info(ref):
    info = json.loads(run(['docker', 'image', 'inspect', ref]))[0]
    require(info['Os'] == 'linux' and info['Architecture'] == 'amd64', '镜像必须为 linux/amd64')
    return info


def fingerprint(info):
    # Unlike .Id, this is stable across Docker's classic/containerd image stores.
    content = {key: info.get(key) for key in ('Os', 'Architecture', 'Config', 'RootFS', 'Created')}
    return hashlib.sha256(json.dumps(content, sort_keys=True).encode()).hexdigest()


def container():
    ids = run(['docker', 'container', 'ls', '-a', '--filter', 'name=^/bifrost$', '--format', '{{.ID}}']).split()
    require(len(ids) <= 1, '发现多个同名 bifrost 容器，无法确定目标')
    return json.loads(run(['docker', 'container', 'inspect', ids[0]]))[0] if ids else None


def local_ip():
    links = json.loads(run(['ip', '-j', '-4', 'address', 'show', 'scope', 'global']))
    found = {addr['local'] for link in links for addr in link.get('addr_info', [])} & LEGACY.keys()
    require(len(found) == 1, '当前主机不属于已登记的三个 Bifrost 节点，或匹配到多个地址')
    return found.pop()


def global_ips():
    links = json.loads(run(['ip', '-j', '-4', 'address', 'show', 'scope', 'global']))
    return {addr['local'] for link in links for addr in link.get('addr_info', [])}


def compose(path, *args, timeout=60):
    # Pin file/project environment; do not inherit COMPOSE_FILE or unrelated .env values.
    env = {k: v for k, v in os.environ.items() if not k.startswith('COMPOSE_')}
    return run(['docker', 'compose', '--env-file', '/dev/null', '-f', str(path), *args], env=env, timeout=timeout)


def check_config(config, role):
    require(set(config) == {'config_store', 'logs_store'}, 'config.json 只能包含两个 PostgreSQL 存储配置')
    environment = 'test' if role == 'test' else 'prod'
    for key, suffix in [('config_store', 'config'), ('logs_store', 'logs')]:
        store = config[key]
        cfg = store.get('config', {})
        require(store.get('enabled') is True and store.get('type') == 'postgres', '配置库和日志库都必须使用 PostgreSQL')
        expected = {'host': '10.1.12.7', 'user': f'bf_{environment}',
                    'db_name': f'bifrost_{environment}_{suffix}', 'password': 'env.BF_DB_PASSWORD', 'ssl_mode': 'require'}
        require(all(cfg.get(k) == v for k, v in expected.items()) and str(cfg.get('port')) == '5432',
                f'{role}：数据库、账号或 TLS 配置与预期不一致')


def standard_config(role):
    environment = 'test' if role == 'test' else 'prod'
    return {key: {'enabled': True, 'type': 'postgres', 'config': {
        'host': '10.1.12.7', 'port': '5432', 'user': f'bf_{environment}',
        'password': 'env.BF_DB_PASSWORD', 'db_name': f'bifrost_{environment}_{suffix}',
        'ssl_mode': 'require', 'max_idle_conns': 2, 'max_open_conns': maximum,
    }} for key, suffix, maximum in [('config_store', 'config', 5), ('logs_store', 'logs', 10)]}


